<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="#F8F8F8">

        <ImageView
            android:id="@+id/ivProductCart"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerInside"
            android:src="@drawable/th" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/ivProductCart"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNameCart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sữa tươi nguyên chất"
                android:textColor="#333333"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvInfoCart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hộp 1L"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPriceCart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45,000đ"
                android:textColor="#1E88E5"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_quantity_picker"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/btnMinusCart"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="-"
                android:textColor="#1E88E5"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvQuantityCart"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textColor="#333333"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnPlusCart"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="+"
                android:textColor="#1E88E5"
                android:textSize="16sp" />
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>